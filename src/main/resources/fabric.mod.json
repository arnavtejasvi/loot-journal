{
  "schemaVersion": 1,
  "id": "lootjournal",
  "version": "${version}",
  "name": "Loot Journal",
  "description": "Tracks block breaks and attributed item drops per session. Compatible with any loot randomizer.",
  "authors": ["arnav"],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.arnav.lootjournal.LootJournalClient"]
  },
  "mixins": [
    {
      "config": "lootjournal.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~26.1",
    "java": ">=25",
    "fabric-api": "*"
  }
}
